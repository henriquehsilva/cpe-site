rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /adminUsers/{document=**} {
      // Qualquer admin autenticado pode ler (para carregar suas permissões)
      allow read: if request.auth != null;
      // Somente o super admin pode escrever (criar, deletar, editar tudo)
      allow write: if request.auth != null
                   && request.auth.token.email == 'sad31chagas@gmail.com';
      // Qualquer admin pode atualizar apenas a própria foto de perfil
      allow update: if request.auth != null
                    && resource.data.email == request.auth.token.email
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['avatarUrl', 'updatedAt']);
    }
    match /photos/{document=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    match /adminData/{documentId} {
      allow read, create, update, delete: if request.auth != null;
    }
  }
}
